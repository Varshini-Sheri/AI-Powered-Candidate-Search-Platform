# Only these two come from you. Everything else is written to .env.local by `make setup`.
# Model key: set ONE of these. Anthropic is used if both are set (override with LLM_PROVIDER).
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
STRIPE_WEBHOOK_SECRET=whsec_rotto_assessment_sample

# Optional
# LLM_PROVIDER=anthropic          # or gemini
# LLM_MODEL=claude-haiku-5-5      # gemini default: gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low       # gemini default: low
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
