# Only these two come from you. Everything else is written to .env.local by `make setup`.
# Model: Gemini 3.5 Flash-Lite (the model this app was built and tested with).
GEMINI_API_KEY=
STRIPE_WEBHOOK_SECRET=whsec_rotto_assessment_sample

# Optional
# LLM_MODEL=gemini-3.5-flash-lite    # default
# GEMINI_THINKING_LEVEL=low          # default
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# To use Anthropic instead: set ANTHROPIC_API_KEY, LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5